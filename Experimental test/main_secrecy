%% Assume we have the matrix for different frequencies
%%{
clear variables
clc
close all
%restoredefaultpath
addpath('./functions')
addpath(genpath('/home/mdbab3f/Documents/Projects/cvx'), '-begin');
load('Data/VV_secrecy.mat');
v=VV_secrecy_40(:,1:5);
ve=VV_secrecy_50(:,1:5);
K=5;
N=30;
%sigma2n=2.26;
sigma2n=1;
normalizedpower=db2pow(2*[-6 -1.5 0 -0.4 -4]); % Main 2 is for amplitude to power
%normalizedpower=normalizedpower.^2;
%normalizedpower=db2pow([-1.5 0 -0.4 -2]); % Fake
for k=1:K
   a1(:,k)=exp(1i*voltagephase(v(:,k))/180*pi)';
   %a1(:,k)=a1(:,k)/a1(3,k);
   A1(:,:,k)=a1(:,k)*a1(:,k)';
   a1e(:,k)=exp(1i*voltagephase(ve(:,k))/180*pi)';
   %a1e(:,k)=a1e(:,k)/a1e(3,k);
   A1e(:,:,k)=a1e(:,k)*a1e(:,k)';
   f(k)=60e9+(k-floor(K/2)-1)*2e9;
   beta(k)=1+2.4*(f(k)/60e9-1);
   %a2(:,k)=a1(:,k).^beta(k);
   %A2(:,:,k)=a2(:,k)*a2(:,k)';
   %a2e(:,k)=a1e(:,k).^beta(k);
   %A2e(:,:,k)=a2e(:,k)*a2e(:,k)';
end
%%}
%% Benchmark 1: Only considering the channel impact not element
gamma1=0;
for jj=1:4
  
A=A1-gamma1*A1e;
S_0=A(:,:,K)';
Imax=12;
eta=0.01;
for ii=1:Imax
[V_2,D_2]=eig(S_0);
[~,index_v]=max(diag(D_2));
V_2=V_2(:,index_v);
cvx_begin
%cvx_solver MOSEK
variable S(N,N) complex hermitian;
variable gamma1
maximize gamma1-eta*(real(trace(S)-trace(V_2*V_2'*(S-S_0))))
subject to
diag(S)==1;
S== hermitian_semidefinite(N);
for k=1:K
   sigma2n*(gamma1-1)<=real(trace(A(:,:,k)*S))*normalizedpower(k);
end
cvx_end
eta=min(5*eta,5*10^5);
S_0=S;
end
end
s=(sqrt(max(max(D_2)))*V_2)';
s=s/s(3);
vs=phasevoltage(mod(angle(s),2*pi)*180/pi).';
%% Proposed: With considering element frequency response
gammaP=gamma1;
for jj=1:3
A=A1-gammaP*A1e;
S_0=S;
Imax=8;
eta=100;
for ii=1:Imax
[V_2,D_2]=eig(S_0);
[~,index_v]=max(diag(D_2));
V_2=V_2(:,index_v);
cvx_begin
%cvx_solver MOSEK
variable S(N,N) complex hermitian;
variable gammaP
maximize gammaP-eta*(real(trace(S)-trace(V_2*V_2'*(S-S_0))))
subject to
diag(S)==1;
S== hermitian_semidefinite(N);
for k=1:K
   sigma2n*(gammaP-1)<=real(trace(A(:,:,k)*(S_0.^beta(k)+beta(k)*S_0.^(beta(k)-1).*(S-S_0))))*normalizedpower(k);
end
cvx_end
eta=min(5*eta,5*10^5);
S_0=S;
end
end
sP=(sqrt(max(max(D_2)))*V_2)';
sP=sP/sP(3);
vsP=phasevoltage(mod(angle(sP),2*pi)*180/pi).';
%% Benchmark 2: Only considering the channel impact not element and center frequency
gamma2=0;
S_0=A(:,:,3)';
Imax=12;
eta=0.01;
for jj=1:2
A=A1-gamma2*A1e;
%A=A1; % Test
for ii=1:Imax
[V_2,D_2]=eig(S_0);
[~,index_v]=max(diag(D_2));
V_2=V_2(:,index_v);
cvx_begin
%cvx_solver MOSEK
variable S(N,N) complex hermitian;
variable gamma2
maximize gamma2-eta*(real(trace(S)-trace(V_2*V_2'*(S-S_0))))
subject to
diag(S)==1;
S== hermitian_semidefinite(N);
sigma2n*(gamma2-1)<=real(trace(A(:,:,3)*S))*normalizedpower(3);
cvx_end
eta=min(5*eta,5*10^5);
S_0=S;
end
end
s2=(sqrt(max(max(D_2)))*V_2)';
s2=s2/s2(3);
vs2=phasevoltage(mod(angle(s2),2*pi)*180/pi).';
%% Internal simulation TEST
for k=1:K
   y1(k)=pow2db((abs(s.^beta(k)*a1(:,k))*sqrt(normalizedpower(k))+sigma2n)/(sigma2n))-53.5;
   y2(k)=pow2db((abs(s2.^beta(k)*a1(:,k))*sqrt(normalizedpower(k))+sigma2n)/(sigma2n))-53.5;
   yP(k)=pow2db((abs(sP.^beta(k)*a1(:,k))*sqrt(normalizedpower(k))+sigma2n)/(sigma2n))-53.5;
   y1e(k)=pow2db((abs(s.^beta(k)*a1e(:,k))*sqrt(normalizedpower(k))+sigma2n)/(sigma2n))-53.5;
   y2e(k)=pow2db((abs(s2.^beta(k)*a1e(:,k))*sqrt(normalizedpower(k))+sigma2n)/(sigma2n))-53.5;
   yPe(k)=pow2db((abs(sP.^beta(k)*a1e(:,k))*sqrt(normalizedpower(k))+sigma2n)/(sigma2n))-53.5;
   y1f(k)=pow2db((abs(s.^beta(k)*a1(:,k))^2*normalizedpower(k)+sigma2n)/(abs(s.^beta(k)*a1e(:,k))^2*normalizedpower(k)+sigma2n));
   y2f(k)=pow2db((abs(s2.^beta(k)*a1(:,k))^2*normalizedpower(k)+sigma2n)/(abs(s2.^beta(k)*a1e(:,k))^2*normalizedpower(k)+sigma2n));
   yPf(k)=pow2db((abs(sP.^beta(k)*a1(:,k))^2*normalizedpower(k)+sigma2n)/(abs(sP.^beta(k)*a1e(:,k))^2*normalizedpower(k)+sigma2n));
end
k=((1:K)-3)*2e9+60e9;
figure
plot(k,y1,k,y2,k,yP)
ylim([-55 -30])
figure
plot(k,y1e,k,y2e,k,yPe)
ylim([-55 -30])
figure
plot(k,y1f,k,y2f,k,yPf)
